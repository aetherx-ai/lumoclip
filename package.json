    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.1.0",
    "googleapis": "^174.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-fast-marquee": "^1.6.5",
    "react-helmet-async": "^3.0.0",
